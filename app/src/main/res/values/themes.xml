<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DriverGuard" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg_root</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg_root</item>
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:statusBarColor">@color/bg_root</item>
        <item name="android:navigationBarColor">@color/bg_root</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="materialAlertDialogTheme">@style/Theme.DriverGuard.Dialog</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="switchStyle">@style/Widget.DG.Switch</item>
    </style>

    <style name="Theme.DriverGuard.Alarm">
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:statusBarColor">@color/danger</item>
        <item name="android:navigationBarColor">@color/bg_root</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.DriverGuard.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/ink_primary</item>
        <item name="shapeAppearanceOverlay">@style/Shape.Dialog</item>
    </style>

    <style name="Shape.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.DG.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>

    <style name="TextDisplay">
        <item name="android:textColor">@color/ink_primary</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextH1">
        <item name="android:textColor">@color/ink_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextH2">
        <item name="android:textColor">@color/ink_primary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextBody">
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <style name="TextCaption">
        <item name="android:textColor">@color/ink_tertiary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="CardSurface" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/bg_card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="ButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">#04121A</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="ButtonDanger" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="backgroundTint">@color/danger</item>
        <item name="android:textColor">#1A0208</item>
    </style>

    <style name="ButtonGhost" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="strokeColor">@color/bg_card_stroke</item>
        <item name="android:textColor">@color/ink_primary</item>
    </style>

</resources>
