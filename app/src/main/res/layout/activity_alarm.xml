<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/danger">

    <com.driverguard.eyetrack.ui.view.AlarmPulseView
        android:id="@+id/pulse"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_alarm"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="80dp"
        android:paddingEnd="28dp"
        android:paddingBottom="44dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_alarm_chip"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.14"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="ТРЕВОГА · 3 УРОВЕНЬ"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/alarmTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:lineSpacingExtra="-2dp"
            android:text="ПРОСНИСЬ"
            android:textColor="#FFFFFF"
            android:textSize="58sp"
            android:letterSpacing="-0.03" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/alarmReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Глаза закрыты 1.4 с"
            android:textColor="#FFD9DF"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="ОСТАНОВИСЬ И ОТДОХНИ"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:letterSpacing="0.06" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="15 минутный сон восстанавливает бдительность лучше кофе. Если сон позывает снова — остановитесь."
            android:textColor="#F2D5DA"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWake"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="26dp"
            android:backgroundTint="#FFFFFF"
            android:text="@string/alarm_wake"
            android:textColor="#B8102A"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStopTrip"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Завершить поездку"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:cornerRadius="18dp"
            app:strokeColor="#66FFFFFF"
            app:strokeWidth="1dp"
            android:backgroundTint="#33FFFFFF" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
