<?xml version="1.0" encoding="utf-8"?>
<!--
  DriverGuard launcher background (adaptive icon layer).
  Full-bleed 108x108dp dark navy gradient + soft radial cyan glow behind the icon center.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base: full-bleed diagonal gradient #0B1320 -> #162034 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="6"
                android:startY="2"
                android:endX="104"
                android:endY="108"
                android:startColor="#FF0B1320"
                android:centerColor="#FF111A2A"
                android:endColor="#FF162034" />
        </aapt:attr>
    </path>

    <!-- Radial cyan glow behind the icon center (layer 1: wide, very soft) -->
    <path
        android:pathData="M54,55 m-44,0 a44,44 0 1,0 88,0 a44,44 0 1,0 -88,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="55"
                android:gradientRadius="46"
                android:startColor="#2622D3EE"
                android:centerColor="#1222D3EE"
                android:endColor="#0022D3EE" />
        </aapt:attr>
    </path>

    <!-- Radial cyan glow (layer 2: tight core under the eye) -->
    <path
        android:pathData="M54,58 m-24,0 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="58"
                android:gradientRadius="26"
                android:startColor="#1F22D3EE"
                android:endColor="#0022D3EE" />
        </aapt:attr>
    </path>

    <!-- Subtle top-left lift so the plate does not look flat -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="78"
                android:endY="96"
                android:startColor="#14FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

</vector>
