<?xml version="1.0" encoding="utf-8"?>
<!--
  DriverGuard launcher foreground (adaptive icon layer).
  Canvas 108x108dp; all artwork stays inside the 66x66dp safe zone (x/y 21..87).
  Motif: shield-shaped open eye + two sleepy "Z" glyphs, upper right.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft cyan halo behind the eye (very low alpha, adds depth on dark bg) -->
    <path
        android:fillColor="#1422D3EE"
        android:pathData="M23.5,54 A30.5,30.5 0 1,0 84.5,54 A30.5,30.5 0 1,0 23.5,54 Z" />

    <!-- Shield plate: fills the lower half of the eye so the shield silhouette reads light-on-dark -->
    <path
        android:fillColor="#B30E1826"
        android:pathData="M54,47 L65.5,49.5 L65.5,60 C65.5,65.2 60.2,68.4 54,70.1 C47.8,68.4 42.5,65.2 42.5,60 L42.5,49.5 Z" />

    <!-- Eye outline / shield almond: full stroke, not clipped -->
    <path
        android:strokeColor="#22D3EE"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M30,60.5 C37.5,51 45.4,46 54,46 C62.6,46 70.5,51 78,60.5 C70.5,70 62.6,75 54,75 C45.4,75 37.5,70 30,60.5 Z" />

    <!-- Inner accent arc: keeps the shield/almond shape legible at 48dp -->
    <path
        android:strokeColor="#4D22D3EE"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M34.8,60 C41,52.6 47.5,48.6 54,48.6 C60.5,48.6 67,52.6 73.2,60" />

    <!-- Iris -->
    <path
        android:strokeColor="#22D3EE"
        android:strokeWidth="2.4"
        android:pathData="M44.6,54 A9.4,9.4 0 1,0 63.4,54 A9.4,9.4 0 1,0 44.6,54 Z" />

    <!-- Pupil (dark, punched through the iris) -->
    <path
        android:fillColor="#0A111D"
        android:pathData="M48.8,54 A5.2,5.2 0 1,0 59.2,54 A5.2,5.2 0 1,0 48.8,54 Z" />

    <!-- Specular catch-light -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.9"
        android:pathData="M49.2,51.1 A1.9,1.9 0 1,0 53,51.1 A1.9,1.9 0 1,0 49.2,51.1 Z" />

    <!-- Sleepy glyph 1 (larger Z, upper right, clear of the eye edge) -->
    <path
        android:strokeColor="#F2F6FF"
        android:strokeAlpha="0.78"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M63.4,30.4 L70.6,30.4 L63.4,39.4 L70.6,39.4" />

    <!-- Sleepy glyph 2 (smaller Z, up and to the right of the first) -->
    <path
        android:strokeColor="#22D3EE"
        android:strokeAlpha="0.75"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M70.6,24.8 L74.6,24.8 L70.6,29.8 L74.6,29.8" />

</vector>
